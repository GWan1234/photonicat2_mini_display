{
  "display_template": {
    "elements": {
      "page0": [
        {
          "type": "fixed_text",
          "label": "Disk Free",
          "position": {
            "x": 100,
            "y": 235
          },
          "font": "tiny",
          "color": [255, 229, 0],
          "enable": 0
        },
        {
          "type": "text",
          "position": {
            "x": 100,
            "y": 250
          },
          "font": "unit",
          "color": [255, 229, 255],
          "units": "MB",
          "data_key": "DiskFreeMB",
          "units_font": "tiny",
          "enable": 0
        }
      ]
    }
  },
  "custom_metrics": {
    "sources": [
      {
        "type": "command",
        "name": "DiskFree",
        "enabled": 0,
        "config": {
          "command": "./get_disk_free_mb.sh",
          "interval": 10,
          "timeout": 2,
          "parser": "stdout",
          "data_key": "DiskFreeMB"
        }
      },
      {
        "type": "command",
        "name": "DiskFreeAlternative",
        "enabled": 0,
        "config": {
          "command": "df / | awk 'NR==2 {print int($4/1024)}'",
          "interval": 10,
          "timeout": 2,
          "parser": "stdout",
          "data_key": "DiskFreeMB"
        }
      },
      {
        "type": "http_poll",
        "name": "RemoteDiskMetrics",
        "enabled": 0,
        "config": {
          "url": "http://your-server:8080/metrics/disk",
          "method": "GET",
          "interval": 30,
          "timeout": 5,
          "parser": "json:disk.free_mb",
          "data_key": "RemoteDiskFreeMB"
        }
      },
      {
        "type": "http_poll",
        "name": "PublicIP",
        "enabled": 0,
        "config": {
          "url": "https://api.ipify.org",
          "method": "GET",
          "interval": 300,
          "timeout": 10,
          "parser": "stdout",
          "data_key": "MyPublicIP"
        }
      },
      {
        "type": "http_poll",
        "name": "WeatherTemp",
        "enabled": 0,
        "config": {
          "url": "https://wttr.in/Shanghai?format=j1",
          "method": "GET",
          "interval": 1800,
          "timeout": 10,
          "parser": "json:current_condition.0.temp_C",
          "data_key": "WeatherTempC"
        }
      },
      {
        "type": "command",
        "name": "LanIP",
        "enabled": 0,
        "config": {
          "command": "uci get network.lan.ipaddr",
          "interval": 60,
          "timeout": 2,
          "parser": "stdout",
          "data_key": "LanIP"
        }
      },
      {
        "type": "command",
        "name": "WifiSSID",
        "enabled": 0,
        "config": {
          "command": "uci get wireless.@wifi-iface[0].ssid",
          "interval": 60,
          "timeout": 2,
          "parser": "stdout",
          "data_key": "WifiSSID"
        }
      },
      {
        "type": "command",
        "name": "CpuLoad1m",
        "enabled": 0,
        "config": {
          "command": "cat /proc/loadavg",
          "interval": 5,
          "timeout": 2,
          "parser": "regex:^([0-9.]+)",
          "data_key": "CpuLoad1m"
        }
      },
      {
        "type": "command",
        "name": "Uptime",
        "enabled": 0,
        "config": {
          "command": "uptime -p",
          "interval": 60,
          "timeout": 2,
          "parser": "stdout",
          "data_key": "Uptime"
        }
      },
      {
        "type": "env",
        "name": "EnvironmentMetrics",
        "enabled": 0,
        "config": {
          "variables": [
            {
              "env_var": "CUSTOM_DISK_FREE",
              "data_key": "EnvDiskFreeMB",
              "default": "N/A"
            }
          ]
        }
      },
      {
        "type": "json_file",
        "name": "JSONFileMetrics",
        "enabled": 0,
        "config": {
          "path": "/tmp/metrics.json",
          "interval": 5,
          "mappings": [
            {
              "json_path": "disk.free_mb",
              "data_key": "JSONDiskFreeMB"
            }
          ]
        }
      }
    ],
    "global_settings": {
      "enable_logging": 1,
      "error_retry_interval": 30,
      "max_retries": 3
    }
  }
}
